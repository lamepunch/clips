---
import type { Column } from "drizzle-orm";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";

interface Props {
  cols: Record<string, Column>;
  row?: Record<string, unknown>;
}
const { cols, row } = Astro.props;

// datetime-local wants "YYYY-MM-DDTHH:mm".
const dt = (v: unknown) =>
  v instanceof Date ? v.toISOString().slice(0, 16) : "";
---

{
  Object.entries(cols)
    .filter(([, col]) => !col.primary)
    .map(([key, col]) => {
      const value = row?.[key];
      const required = col.notNull && !col.hasDefault;
      return (
        <div class="grid gap-2 mb-4">
          <Label for={key}>{key}</Label>
          {col.dataType === "boolean" ? (
            <input
              type="checkbox"
              id={key}
              name={key}
              checked={!!value}
              class="size-4 justify-self-start"
            />
          ) : col.dataType === "number" ? (
            <Input
              type="number"
              id={key}
              name={key}
              value={value as number}
              required={required}
            />
          ) : col.dataType === "date" ? (
            <Input
              type="datetime-local"
              id={key}
              name={key}
              value={dt(value)}
              required={required}
            />
          ) : (
            <Input
              type="text"
              id={key}
              name={key}
              value={(value as string) ?? ""}
              required={required}
            />
          )}
        </div>
      );
    })
}
