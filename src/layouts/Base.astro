---
import "@/styles/starwind.css";
import BrandDiscord from "@tabler/icons/filled/brand-discord.svg";
import { Button } from "@/components/starwind/button";
import {
  Dropdown,
  DropdownContent,
  DropdownItem,
  DropdownLabel,
  DropdownSeparator,
  DropdownTrigger,
} from "@/components/starwind/dropdown";

interface Props {
  title?: string;
}
const { title = "Clips" } = Astro.props;
const { user } = Astro.locals;
---

<!doctype html>
<html lang="en-us" class="dark">
  <head>
    <title>{title} &middot; Lamepunch</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <header class="flex items-center gap-4 p-4 border-b border-border">
      <a href="/" class="font-semibold">Lamepunch</a>
      {
        user && (
          <a href="/upload" class="text-primary hover:underline">
            Upload
          </a>
        )
      }

      <div class="ml-auto">
        {
          user ? (
            <Dropdown>
              <DropdownTrigger class="flex items-center gap-2">
                {user.image && (
                  <img
                    src={user.image}
                    alt=""
                    width="24"
                    height="24"
                    class="rounded-full"
                  />
                )}
                {user.name}
              </DropdownTrigger>
              <DropdownContent align="end">
                <DropdownLabel>{user.name}</DropdownLabel>
                <DropdownSeparator />
                <DropdownItem as="a" href={`/${user.slug}`}>
                  My profile
                </DropdownItem>
                {user.role == "admin" && (
                  <DropdownItem as="a" href="/admin">
                    Admin
                  </DropdownItem>
                )}
                <DropdownSeparator />
                <DropdownItem as="button" type="button" id="sign-out" class="w-full">
                  Sign out
                </DropdownItem>
              </DropdownContent>
            </Dropdown>
          ) : (
            <Button type="button" id="sign-in" variant="secondary" size="sm">
              <BrandDiscord class="size-4" />
              Sign in
            </Button>
          )
        }
      </div>
    </header>

    <script>
      import { authClient } from "@/lib/authClient";

      document.querySelector("#sign-in")?.addEventListener("click", () => {
        authClient.signIn.social({
          provider: "discord",
          callbackURL: location.pathname,
        });
      });

      document
        .querySelector("#sign-out")
        ?.addEventListener("click", async () => {
          await authClient.signOut();
          location.href = "/";
        });
    </script>
    <main class="p-4">
      <slot />
    </main>
  </body>
</html>
