---
import "@/styles/starwind.css";
import Home from "@tabler/icons/outline/home.svg";
import Logout from "@tabler/icons/outline/logout.svg";
import Settings from "@tabler/icons/outline/settings.svg";
import Upload from "@tabler/icons/outline/upload.svg";
import User from "@tabler/icons/outline/user.svg";
import {
  Dropdown,
  DropdownContent,
  DropdownItem,
  DropdownLabel,
  DropdownSeparator,
  DropdownTrigger,
} from "@/components/starwind/dropdown";

interface Props {
  title?: string;
  /** OpenGraph description for link embeds (Discord). */
  description?: string;
  /** OpenGraph image URL; renders a large-image card. */
  image?: string;
  /** OpenGraph type, only used alongside `image`. */
  ogType?: string;
}
const {
  title = "Clips",
  description,
  image,
  ogType = "video.other",
} = Astro.props;
const { user } = Astro.locals;
---

<!doctype html>
<html lang="en-us" class="dark">
  <head>
    <title>{title} &middot; Lamepunch</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Link embeds (Discord). theme-color sets the embed's left border. */}
    <meta property="og:site_name" content="Lamepunch Clips" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="theme-color" content="#a78bfa" />
    {description && <meta property="og:description" content={description} />}
    {
      image && (
        <>
          <meta property="og:type" content={ogType} />
          <meta property="og:image" content={image} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>
  <body>
    {
      user && (
        <header class="flex items-center gap-4 p-5 border-b border-border bg-neutral-800">
          <div class="grid gap-0.5 font-semibold leading-none">
            <span class="text-[0.625rem] tracking-[0.25em] uppercase">Lamepunch</span>
            <span>Clips</span>
          </div>

          <a href="/" class="flex items-center gap-1.5 text-primary hover:underline">
            <Home class="size-4" />
            Home
          </a>
          {user.role !== "viewer" && (
            <a
              href="/upload"
              class="flex items-center gap-1.5 text-primary hover:underline"
            >
              <Upload class="size-4" />
              Upload
            </a>
          )}

          <div class="ml-auto">
            <Dropdown>
              <DropdownTrigger class="flex items-center gap-2">
                {user.image && (
                  <img
                    src={user.image}
                    alt=""
                    width="24"
                    height="24"
                    class="rounded-full"
                  />
                )}
                {user.name}
              </DropdownTrigger>
              <DropdownContent align="end">
                <DropdownLabel>{user.name}</DropdownLabel>
                <DropdownSeparator />
                <DropdownItem as="a" href={`/${user.slug}`}>
                  <User />
                  Profile
                </DropdownItem>
                {user.role == "admin" && (
                  <DropdownItem as="a" href="/admin">
                    <Settings />
                    Admin
                  </DropdownItem>
                )}
                <DropdownSeparator />
                <DropdownItem as="button" type="button" id="sign-out" class="w-full">
                  <Logout />
                  Sign out
                </DropdownItem>
              </DropdownContent>
            </Dropdown>
          </div>
        </header>
      )
    }

    <script>
      import { authClient } from "@/lib/authClient";

      document.querySelector("#sign-in")?.addEventListener("click", () => {
        authClient.signIn.social({
          provider: "discord",
          callbackURL: "/",
        });
      });

      document
        .querySelector("#sign-out")
        ?.addEventListener("click", async () => {
          await authClient.signOut();
          location.href = "/";
        });
    </script>
    <main class="p-4">
      <slot />
    </main>
  </body>
</html>
