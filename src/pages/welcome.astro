---
import BrandDiscord from "@tabler/icons/filled/brand-discord.svg";
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/starwind/button";

const roundels = [
  ["15", "bg-[#EE352E]"],
  ["77", "bg-[#B933AD]"],
  ["40", "bg-[#FF6319]"],
  ["J", "bg-[#996633]"],
  ["C", "bg-[#006400]"],
  ["F", "bg-[#800000]"],
  ["D", "bg-[#0039A6]"],
  ["A", "bg-[#00ADD0]"],
  ["L", "bg-[#013220]"],
  ["G", "bg-[#FF00FF]"],
  ["R", "bg-[#AA336A]"],
].sort(() => Math.random() - 0.5);
---

<Base title="Clips">
  <section class="mx-auto grid min-h-[calc(100svh-2rem)] max-w-xl content-center gap-4">
    <div class="flex flex-wrap justify-end gap-2">
      {
        roundels.map(([label, color]) => (
          <span
            class={`${color} size-10 rounded-full flex items-center justify-center text-white font-bold`}
          >
            {label}
          </span>
        ))
      }
    </div>
    <h1 class="text-right font-bold">
      <span class="block text-sm tracking-[0.3em] uppercase">Lamepunch</span>
      <span class="block text-6xl">Clips</span>
    </h1>
    <hr>
    <p class="text-lg">
      A place for friends to upload funny video game clips and have them be
      preserved forever. Or at least until I stop wanting to pay for
      the Cloudflare bill.
    </p>
    <p class="text-muted-foreground">
      Sign in with Discord to get started. Access is currently limited to TF-R40
      operatives and known associates.
    </p>
    <Button type="button" id="sign-in" class="justify-self-start">
      <BrandDiscord class="size-4" />
      Sign in
    </Button>
  </section>
</Base>
