---
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { games } from "@/db/schema";

const { request, redirect, locals } = Astro;
const { db } = locals;

let error: string | null = null;
if (request.method === "POST") {
  const form = await request.formData();
  const igdbId = Number(form.get("igdbId"));
  const title = String(form.get("title") ?? "").trim();
  if (!igdbId || !title) {
    error = "igdbId and title are required.";
  } else {
    try {
      await db.insert(games).values({
        igdbId,
        title,
        slug: String(form.get("slug") ?? "").trim() || null,
        image: String(form.get("image") ?? "").trim() || null,
      });
      return redirect("/admin/games");
    } catch (err) {
      error = err instanceof Error ? err.message : String(err);
    }
  }
}
---

<Base title="Admin · new game">
  <p>
    <a href="/admin/games" class="text-primary hover:underline">← games</a>
  </p>
  <h1 class="text-2xl font-bold my-2">New game</h1>
  {error && <p class="text-error mb-2">{error}</p>}

  <Input
    type="search"
    id="igdb-search"
    placeholder="Search IGDB…"
    autocomplete="off"
    class="max-w-md"
  />
  <ul id="igdb-results" class="max-w-md grid gap-1 my-2"></ul>

  <form method="POST" class="grid gap-4 max-w-md mt-4">
    <div class="grid gap-2">
      <Label for="f-title">Title</Label>
      <Input type="text" name="title" id="f-title" required />
    </div>
    <div class="grid gap-2">
      <Label for="f-igdbId">IGDB ID</Label>
      <Input type="number" name="igdbId" id="f-igdbId" required />
    </div>
    <div class="grid gap-2">
      <Label for="f-slug">Slug</Label>
      <Input type="text" name="slug" id="f-slug" />
    </div>
    <div class="grid gap-2">
      <Label for="f-image">Image</Label>
      <Input type="url" name="image" id="f-image" />
    </div>
    <Button type="submit" class="justify-self-start">Create</Button>
  </form>

  <script>
    type Result = {
      igdbId: number;
      title: string;
      slug: string;
      image: string | null;
    };

    const search = document.querySelector<HTMLInputElement>("#igdb-search")!;
    const list = document.querySelector<HTMLUListElement>("#igdb-results")!;
    const fields = {
      title: document.querySelector<HTMLInputElement>("#f-title")!,
      igdbId: document.querySelector<HTMLInputElement>("#f-igdbId")!,
      slug: document.querySelector<HTMLInputElement>("#f-slug")!,
      image: document.querySelector<HTMLInputElement>("#f-image")!,
    };

    let timer: ReturnType<typeof setTimeout>;
    search.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 300);
    });

    async function run() {
      const q = search.value.trim();
      if (!q) return (list.innerHTML = "");
      const res = await fetch(`/api/games/search?q=${encodeURIComponent(q)}`);
      if (!res.ok) return;
      const games: Result[] = await res.json();

      list.innerHTML = "";
      for (const g of games) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "text-primary hover:underline text-left";
        btn.textContent = g.slug ? `${g.title} (${g.slug})` : g.title;
        btn.addEventListener("click", () => {
          fields.title.value = g.title;
          fields.igdbId.value = String(g.igdbId);
          fields.slug.value = g.slug;
          fields.image.value = g.image ?? "";
          list.innerHTML = "";
          search.value = g.title;
        });
        li.appendChild(btn);
        list.appendChild(li);
      }
    }
  </script>
</Base>
