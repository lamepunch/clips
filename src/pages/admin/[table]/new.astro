---
import { getTableColumns } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import AdminFields from "@/components/AdminFields.astro";
import { Button } from "@/components/starwind/button";
import { formValues, getAdminTable } from "@/lib/admin";

const { db, user } = Astro.locals;
const { table: name } = Astro.params;
const table = getAdminTable(name);
if (!table) return new Response("Not found", { status: 404 });

let error: string | null = null;
if (Astro.request.method === "POST") {
  const values = formValues(table, await Astro.request.formData());
  try {
    // ponytail: generic admin over a table union — full typing isn't worth it.
    await db.insert(table as never).values(values as never);
    return Astro.redirect(`/admin/${name}`);
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const cols = getTableColumns(table);
---

<Base title={`Admin · new ${name}`}>
  <p>
    <a href={`/admin/${name}`} class="text-primary hover:underline">
      ← {name}
    </a>
  </p>
  <h1 class="text-2xl font-bold my-2">New {name}</h1>
  {error && <p class="text-error mb-2">{error}</p>}
  <form method="POST" class="max-w-md">
    {/* Prefill FK-ish defaults; userId = the signed-in admin, still editable. */}
    <AdminFields cols={cols} row={{ userId: user?.id }} />
    <Button type="submit">Create</Button>
  </form>
</Base>
