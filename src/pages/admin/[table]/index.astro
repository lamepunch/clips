---
import { getTableColumns } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/starwind/table";
import { getAdminTable, primaryKey } from "@/lib/admin";
import { notFound } from "@/lib/http";

const { db } = Astro.locals;
const { table: name } = Astro.params;
const table = getAdminTable(name);
if (!table) return notFound();

const cols = Object.keys(getTableColumns(table));
const [pk] = primaryKey(table);
// ponytail: generic admin over a table union — full typing isn't worth it here.
const rows = (await db.select().from(table as never)) as Record<
  string,
  unknown
>[];
---

<Base title={`Admin · ${name}`}>
  <p><a href="/admin" class="text-primary hover:underline">← Admin</a></p>
  <h1 class="text-2xl font-bold my-2">{name}</h1>
  <p class="mb-4">
    <a href={`/admin/${name}/new`} class="text-primary hover:underline">+ New</a>
  </p>

  <Table>
    <TableHeader>
      <TableRow>{cols.map((c) => <TableHead>{c}</TableHead>)}</TableRow>
    </TableHeader>
    <TableBody>
      {
        rows.map((row) => (
          <TableRow>
            {cols.map((c) => (
              <TableCell>
                {c === pk ? (
                  <a
                    href={`/admin/${name}/${row[pk]}/edit`}
                    class="text-primary hover:underline"
                  >
                    {String(row[c])}
                  </a>
                ) : (
                  String(row[c] ?? "")
                )}
              </TableCell>
            ))}
          </TableRow>
        ))
      }
    </TableBody>
  </Table>
  {rows.length === 0 && <p>No rows.</p>}
</Base>
