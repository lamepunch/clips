---
import Base from "@/layouts/Base.astro";
import { user } from "@/db/schema";

const { db, session } = Astro.locals;

if (!session) return Astro.redirect("/welcome");

const l = await db
  .select({
    id: user.id,
    name: user.name,
    slug: user.slug,
    image: user.image,
  })
  .from(user);
---

<Base title="Clips">
  <h1 class="text-2xl font-bold mb-4">Users</h1>
  <ul class="grid gap-2">
    {
      l.map((u) => (
        <li>
          <a
            href={`/${u.slug}`}
            class="flex items-center gap-2 text-primary hover:underline"
          >
            {u.image && (
              <img
                src={u.image}
                alt={u.name}
                width="32"
                height="32"
                loading="lazy"
                class="rounded-full"
              />
            )}
            {u.name}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
