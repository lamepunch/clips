---
import { eq } from "drizzle-orm";
import MediaGrid from "@/components/MediaGrid.astro";
import Base from "@/layouts/Base.astro";
import { user } from "@/db/schema";
import { notFound } from "@/lib/http";
import { clipItems, shotItems, userClips, userShots } from "@/lib/media";

const { db, env } = Astro.locals;
const { slug, type } = Astro.params;

if (type !== "clips" && type !== "shots") return notFound();

const u = slug
  ? await db.query.user.findFirst({ where: eq(user.slug, slug) })
  : undefined;

if (!u) return notFound();

const items =
  type === "clips"
    ? clipItems(env, await userClips(db, u.id))
    : shotItems(await userShots(db, u.id));
---

<Base title={`${u.name}'s ${type} · Clips`}>
  <section class="grid gap-4">
    <div>
      <a href={`/${u.slug}`} class="text-primary hover:underline">
        &larr; {u.name}
      </a>
      <h1 class="text-2xl font-bold capitalize">{type}</h1>
      <p class="text-muted-foreground">
        {items.length} {items.length === 1 ? type.slice(0, -1) : type}
      </p>
    </div>

    <MediaGrid items={items} empty={`No ${type} yet.`} />
  </section>
</Base>
