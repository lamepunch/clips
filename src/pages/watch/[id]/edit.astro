---
import { eq } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Textarea } from "@/components/starwind/textarea";
import { clips } from "@/db/schema";

const { request, redirect } = Astro;
const { id } = Astro.params;
const { db, user } = Astro.locals;

if (!user) return Astro.redirect("/");

const c = id
  ? await db.query.clips.findFirst({ where: eq(clips.id, id) })
  : undefined;

if (!c) return new Response("Not found", { status: 404 });
if (c.userId !== user.id) return new Response("Forbidden", { status: 403 });

if (request.method === "POST") {
  const form = await request.formData();
  const occurred = String(form.get("occurredAt") ?? "");

  await db
    .update(clips)
    .set({
      title: String(form.get("title") ?? ""),
      description: String(form.get("description") ?? ""),
      // ponytail: Workers run in UTC, so the naive datetime-local string round-trips
      // as UTC. Add explicit tz handling if users span timezones and it matters.
      occurredAt: occurred ? new Date(occurred) : null,
    })
    .where(eq(clips.id, c.id));
  return redirect(`/watch/${c.id}`);
}

const occurredValue = c.occurredAt
  ? c.occurredAt.toISOString().slice(0, 16)
  : undefined;
---

<Base title="Edit">
  <h1 class="text-2xl font-bold mb-4">Edit</h1>
  <form method="POST" class="grid gap-4 max-w-md">
    <div class="grid gap-2">
      <Label for="title">Title</Label>
      <Input type="text" id="title" name="title" value={c.title} />
    </div>
    <div class="grid gap-2">
      <Label for="description">Description</Label>
      <Textarea id="description" name="description" rows={4}
        >{c.description}</Textarea
      >
    </div>
    <div class="grid gap-2">
      <Label for="occurredAt">Occurred at</Label>
      <Input
        type="datetime-local"
        id="occurredAt"
        name="occurredAt"
        value={occurredValue}
      />
    </div>
    <Button type="submit" class="justify-self-start">Save</Button>
  </form>
</Base>
