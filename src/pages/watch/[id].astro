---
import { eq } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/starwind/button";
import { clips, ClipStatus } from "@/db/schema";

const { db, env, user } = Astro.locals;
const { id } = Astro.params;

const c = id
  ? await db.query.clips.findFirst({ where: eq(clips.id, id) })
  : undefined;

if (!c) {
  return new Response("Not found", { status: 404 });
}
---

<Base title={c.title || "Clip"}>
  {c.title && <h1 class="text-2xl font-bold mb-4">{c.title}</h1>}
  {
    c.status === ClipStatus.READY ? (
      <iframe
        src={`https://customer-${env.STREAM_CODE}.cloudflarestream.com/${c.uid}/iframe`}
        class="border-0 mx-auto w-full max-w-[calc(80svh*16/9)] aspect-video rounded-md"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
        allowfullscreen
      />
    ) : (
      <p>This clip is still processing. Please come back later!</p>
    )
  }
  {c.description && <p class="mt-2">{c.description}</p>}
  {
    c.userId === user?.id && (
      <p class="mt-2">
        <Button href={`/watch/${c.id}/edit`}>Edit</Button>
      </p>
    )
  }
</Base>
