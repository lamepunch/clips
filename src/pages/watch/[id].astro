---
import { eq } from "drizzle-orm";
import MediaDetail from "@/components/MediaDetail.astro";
import Base from "@/layouts/Base.astro";
import { clips, ClipStatus } from "@/db/schema";
import { notFound } from "@/lib/http";
import { mediaMeta, mediaNeighbors } from "@/lib/media";
import { streamIframeUrl, streamThumbnailUrl } from "@/lib/stream";

const { db, env, user: viewer } = Astro.locals;
const { id } = Astro.params;

const c = id
  ? await db.query.clips.findFirst({ where: eq(clips.id, id) })
  : undefined;

if (!c) {
  return notFound();
}

const [{ uploader, game }, { prevHref, nextHref }] = await Promise.all([
  mediaMeta(db, c),
  mediaNeighbors(db, c, "clips"),
]);

const isReady = c.status === ClipStatus.READY;
---

<Base
  title={c.title || "Clip"}
  description={c.description || undefined}
  image={isReady ? streamThumbnailUrl(env, c.uid) : undefined}
>
  <MediaDetail
    title={c.title || "Untitled clip"}
    description={c.description}
    uploader={uploader}
    game={game}
    createdAt={c.createdAt}
    occurredAt={c.occurredAt}
    isUploader={c.userId === viewer?.id}
    editHref={`/watch/${c.id}/edit`}
    prevHref={prevHref}
    nextHref={nextHref}
  >
    <div class="mx-auto w-full max-w-[calc(85svh*16/9)]">
      {
        isReady ? (
          <iframe
            src={streamIframeUrl(env, c.uid)}
            class="aspect-video w-full border-0"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
            allowfullscreen
          />
        ) : (
          <p class="grid aspect-video place-items-center px-4 text-center">
            This clip is still processing. Please come back later!
          </p>
        )
      }
    </div>
  </MediaDetail>
</Base>
