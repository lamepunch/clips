---
import { eq } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/starwind/button";
import { clips, ClipStatus } from "@/db/schema";
import { notFound } from "@/lib/http";
import { streamIframeUrl, streamThumbnailUrl } from "@/lib/stream";

const { db, env, user } = Astro.locals;
const { id } = Astro.params;

const c = id
  ? await db.query.clips.findFirst({ where: eq(clips.id, id) })
  : undefined;

const isReady = c?.status === ClipStatus.READY;
const isUploader = c?.userId === user?.id;

if (!c) {
  return notFound();
}
---

<Base
  title={c.title || "Clip"}
  description={c.description || undefined}
  image={isReady ? streamThumbnailUrl(env, c.uid) : undefined}
>
  {c.title && <h1 class="text-2xl font-bold mb-4">{c.title}</h1>}
  {
    isReady ? (
      <iframe
        src={streamIframeUrl(env, c.uid)}
        class="border-0 mx-auto w-full max-w-[calc(80svh*16/9)] aspect-video rounded-md"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
        allowfullscreen
      />
    ) : (
      <p>This clip is still processing. Please come back later!</p>
    )
  }
  {c.description && <p class="mt-2">{c.description}</p>}
  {
    isUploader && (
      <p class="mt-2">
        <Button href={`/watch/${c.id}/edit`}>Edit</Button>
      </p>
    )
  }
</Base>
