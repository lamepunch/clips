---
import { and, desc, eq } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { clips, user, ClipStatus } from "@/db/schema";
import { notFound } from "@/lib/http";
import { streamThumbnailUrl } from "@/lib/stream";

const { db, env } = Astro.locals;
const { slug } = Astro.params;

const u = slug
  ? await db.query.user.findFirst({ where: eq(user.slug, slug) })
  : undefined;

if (!u) {
  return notFound();
}

const l = await db
  .select()
  .from(clips)
  .where(
    and(eq(clips.userId, u.id), eq(clips.status, ClipStatus.READY)),
  )
  .orderBy(desc(clips.createdAt));
---

<Base title={`${u.name} · Clips`}>
  <h1 class="text-2xl font-bold mb-4">{u.name}</h1>
  {l.length === 0 && <p>No clips yet.</p>}

  <ul class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(240px,1fr))]">
    {
      l.map((c) => (
        <li>
          <a href={`/watch/${c.id}`} class="block group">
            <img
              src={streamThumbnailUrl(env, c.uid)}
              alt={c.title || "Clip thumbnail"}
              loading="lazy"
              class="w-full aspect-video object-cover rounded-md"
            />
            {c.title && (
              <span class="mt-1 block group-hover:underline">{c.title}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
