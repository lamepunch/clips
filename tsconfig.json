{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    // Starwind barrels import .astro files, which raw `tsc` can't resolve
    // (only `astro check` can). They're only consumed from .astro files.
    "src/components/starwind"
  ],
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers"
    ],
    "strictNullChecks": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
