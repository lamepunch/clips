{
  "name": "clips",
  "type": "module",
  "version": "2026.7",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "wrangler types",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --name initial",
    "db:migrate:local": "wrangler d1 migrations apply clips --local",
    "db:migrate:remote": "wrangler d1 migrations apply clips --remote",
    "auth:generate": "better-auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/tus": "^5.1.1",
    "@uppy/xhr-upload": "^5.2.0",
    "astro": "^7.2.1",
    "better-auth": "^1.6.27",
    "customerio-node": "^5.2.0",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0"
  },
  "comment:overrides": "Pinned exactly: @cloudflare/vite-plugin above 1.51.1 (confirmed still broken at 1.51.3) with wrangler above 4.120.0 (confirmed still broken at 4.121.0) crashes `astro dev` at startup with `Missing field moduleType` from the workerd module runner (build is unaffected). See cloudflare/workers-sdk#15129 — open upstream, re-checked 2026-08-11. Do not loosen either past these versions until it's fixed.",
  "overrides": {
    "@cloudflare/vite-plugin": "1.51.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260801.1": true,
    "workerd@1.20260804.1": true
  }
}
