{
  "name": "clips",
  "type": "module",
  "version": "2026.7",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "wrangler types",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --name initial",
    "db:migrate:local": "wrangler d1 migrations apply clips --local",
    "db:migrate:remote": "wrangler d1 migrations apply clips --remote",
    "auth:generate": "better-auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.1",
    "@tabler/icons": "^3.44.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.2",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/tus": "^5.1.1",
    "astro": "^6.4.4",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.98.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "workerd@1.20260310.1": true,
    "workerd@1.20260603.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
